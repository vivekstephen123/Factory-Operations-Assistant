# Environment Variables for Factory Operations Assistant
# (Optional: the app also includes a built-in fast demo engine that works without any API keys)

# OpenAI API Key (for GPT-4o-mini)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key (for gemini-3.5-flash)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (for gpt-oss-120b)
GROQ_API_KEY=your_groq_api_key_here

# MySQL 8.0 Settings (Optional - fallback to SQLite if blank)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=factory_ops_db
